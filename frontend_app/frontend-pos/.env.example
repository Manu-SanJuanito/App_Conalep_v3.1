# Copia como ".env" solo si quieres probar localmente apuntando a un backend
# que no sea tu 127.0.0.1:8000 (ej. ya probar contra el de Railway).
# En Vercel, define estas mismas variables en el panel del proyecto.
# OJO: todo lo que empieza con VITE_ queda visible en el navegador. Nunca pongas secretos aquí.

VITE_API_URL=https://tu-app.up.railway.app/api

# Texto del aviso de privacidad (opcionales)
VITE_RESPONSABLE=la cooperativa de la cafetería del plantel CONALEP Hidalgo
VITE_CONTACTO_PRIVACIDAD=cafeteria@tu-plantel.edu.mx
