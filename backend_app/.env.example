# Copia este archivo como ".env" para probar en tu compu, o define estas mismas
# variables en el panel de Railway. NUNCA subas un ".env" real a GitHub.

# ---------------- Obligatorias en producción ----------------
# Genera una nueva con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambia-esto-por-una-clave-nueva-y-secreta

# En producción NO la pongas (o ponla en False). Solo en tu compu: DEBUG=True
DEBUG=False

# Dominio que te da Railway, sin http:// ni barra final (separados por coma si son varios)
ALLOWED_HOSTS=tu-app.up.railway.app

# URL de tu frontend en Vercel, con https:// y sin barra final
CORS_ALLOWED_ORIGINS=https://tu-cafeteria.vercel.app

# Railway la define sola al agregar PostgreSQL:
# DATABASE_URL=postgres://usuario:password@host:puerto/nombre_db

# ---------------- Recomendadas ----------------
# Cambia la ruta del panel de Django por algo difícil de adivinar
ADMIN_URL=panel-cooperativa-x7k2/

# ---------------- Horario (por defecto: lunes a viernes, 7:00 a 18:00) ----------------
# HORARIO_ACTIVO=True        # ponlo en False para probar fuera de horario
# HORA_APERTURA=07:00
# HORA_CIERRE=18:00
# DIAS_ABIERTO=0,1,2,3,4     # 0=lunes ... 6=domingo

# ---------------- Reglas ----------------
# DOMINIOS_ALUMNOS=hgo.conalep.edu.mx
# DOMINIOS_DOCENTES=hgo.conalep.edu.mx,conalep.edu.mx
# TOKEN_HORAS=12                  # duración de la sesión
# DIAS_CONSERVAR_PEDIDOS=15       # pedidos más viejos se borran solos

# ---------------- Verificación de correo ----------------
# Mientras no tengas servicio de correo: REQUIRE_EMAIL_VERIFICATION=False
REQUIRE_EMAIL_VERIFICATION=True
# EMAIL_PROVIDER=brevo            # brevo | resend | consola
# EMAIL_API_KEY=la-llave-del-proveedor
# EMAIL_FROM=correo-remitente-verificado@ejemplo.com
# EMAIL_FROM_NOMBRE=Cafetería CONALEP
